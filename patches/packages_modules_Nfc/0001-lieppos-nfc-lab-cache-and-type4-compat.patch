@@ -449,19 +479,36 @@
 void NativeT4tNfcee::cleanup(void) {
   static const char fn[] = "NativeT4tNfcee:cleanup";
   LOG(DEBUG) << StringPrintf("%s", fn);
-  if (sIsNfcOffTriggered) {
-    SyncEventGuard g(mT4tNfcOffEvent);
