     }
     /* Try to close the connection with t4t nfcee, discard the status */
     (void)closeConnection();
+    /* The shutdown path owns closing here; restoration cannot be confirmed. */
+    labLifecycle().abandon();
+    publishLabHealth();
     resetBusy();
