+                if (mT4tNfceeMgr.isNdefOperationOngoing()) throw new IllegalStateException("NDEF endpoint busy");
+                requireCleanLifecycle();
+                int count = mT4tNfceeMgr.doWriteData(new byte[] {(byte)(fileId >> 8), (byte)fileId}, data);
+                requireCleanLifecycle();
+                return count;
+            }
+        });
