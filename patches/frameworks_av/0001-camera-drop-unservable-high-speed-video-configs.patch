+// Some HALs advertise constrained high-speed video sizes they cannot serve and
+// abort when such a session is configured (e.g. MediaTek MT6878: 3840x2160 at
+// 120 fps has no sensor mode). The device lists them in
+//   ro.vendor.camera.drop_high_speed_video_sizes=<cameraId>:<W>x<H>[,...]
+// and they are removed here, so the framework rejects such sessions instead.
+status_t CameraProviderManager::ProviderInfo::DeviceInfo3::removeUnservableHighSpeedVideoConfigs() {
+    const std::string list =
+            base::GetProperty("ro.vendor.camera.drop_high_speed_video_sizes", "");
+    if (list.empty()) return OK;
+
+    std::vector<std::pair<int32_t, int32_t>> drop;
+    for (const std::string& item : base::Split(list, ",")) {
+        const std::string entry = base::Trim(item);
+        const size_t colon = entry.find(':');
+        if (colon == std::string::npos || entry.substr(0, colon) != mId) continue;
+        int32_t w = 0, h = 0;
+        if (sscanf(entry.c_str() + colon + 1, "%dx%d", &w, &h) == 2 && w > 0 && h > 0) {
+            drop.emplace_back(w, h);
+        }
+    }
+    if (drop.empty()) return OK;
+
+    auto& c = mCameraCharacteristics;
+    const camera_metadata_entry configs =
+            c.find(ANDROID_CONTROL_AVAILABLE_HIGH_SPEED_VIDEO_CONFIGURATIONS);
+    // Entries are (width, height, fps_min, fps_max, batch_size_max).
+    if (configs.count == 0 || configs.count % 5 != 0) return OK;
+
+    std::vector<int32_t> kept;
+    size_t removed = 0;
+    for (size_t i = 0; i < configs.count; i += 5) {
+        const std::pair<int32_t, int32_t> size(configs.data.i32[i], configs.data.i32[i + 1]);
+        if (std::find(drop.begin(), drop.end(), size) != drop.end()) {
+            removed++;
+            continue;
+        }
+        kept.insert(kept.end(), configs.data.i32 + i, configs.data.i32 + i + 5);
+    }
+    if (removed == 0) return OK;
+
+    status_t res;
+    if (!kept.empty()) {
+        res = c.update(ANDROID_CONTROL_AVAILABLE_HIGH_SPEED_VIDEO_CONFIGURATIONS,
+                kept.data(), kept.size());
+    } else {
+        // Nothing left: the device no longer offers constrained high-speed video.
+        res = c.erase(ANDROID_CONTROL_AVAILABLE_HIGH_SPEED_VIDEO_CONFIGURATIONS);
+        const camera_metadata_entry caps = c.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+        if (res == OK && caps.count > 0) {
+            std::vector<uint8_t> newCaps;
+            for (size_t i = 0; i < caps.count; i++) {
+                if (caps.data.u8[i] !=
+                        ANDROID_REQUEST_AVAILABLE_CAPABILITIES_CONSTRAINED_HIGH_SPEED_VIDEO) {
+                    newCaps.push_back(caps.data.u8[i]);
+                }
+            }
+            res = c.update(ANDROID_REQUEST_AVAILABLE_CAPABILITIES, newCaps.data(),
+                    newCaps.size());
+        }
+    }
+    if (res != OK) {
+        ALOGE("%s: Camera %s: failed to update high-speed video configurations: %s (%d)",
+                __FUNCTION__, mId.c_str(), strerror(-res), res);
+        return res;
+    }
+    ALOGI("%s: Camera %s: removed %zu unservable high-speed video configuration(s)",
+            __FUNCTION__, mId.c_str(), removed);
+    return OK;
+}
