+    /**
+     * LieppOS: system apps that may open one specific built-in USB device without the
+     * per-connection permission dialog (e.g. ThermoVue and the internal thermal camera,
+     * which re-enumerates every time the app powers it). Device-tree property:
+     * ro.lieppos.usb_device_allowlist = "package:vid:pid[,package:vid:pid...]" (hex ids).
+     * Only apps installed on a system partition, with the exact uid, are accepted.
+     */
+    private boolean isAllowlistedSystemApp(UsbDevice device, String packageName, int uid) {
+        String list = SystemProperties.get("ro.lieppos.usb_device_allowlist", "");
+        if (list.isEmpty() || packageName == null) {
+            return false;
+        }
+        boolean match = false;
+        for (String entry : list.split(",")) {
+            String[] f = entry.trim().split(":");
+            if (f.length != 3 || !f[0].equals(packageName)) {
+                continue;
+            }
+            try {
+                if (Integer.parseInt(f[1], 16) == device.getVendorId()
+                        && Integer.parseInt(f[2], 16) == device.getProductId()) {
+                    match = true;
+                    break;
+                }
+            } catch (NumberFormatException e) {
+                Slog.w(TAG, "bad ro.lieppos.usb_device_allowlist entry: " + entry);
+            }
+        }
+        if (!match) {
+            return false;
+        }
+        final long token = Binder.clearCallingIdentity();
+        try {
+            ApplicationInfo ai = mContext.getPackageManager().getApplicationInfoAsUser(
+                    packageName, 0, UserHandle.getUserId(uid));
+            return ai.uid == uid && ai.isSystemApp();
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
