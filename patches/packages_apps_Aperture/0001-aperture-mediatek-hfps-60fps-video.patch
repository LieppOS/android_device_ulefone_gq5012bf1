     val supportsZsl = cameraInfo.isZslSupported
 
+    /**
+     * MediaTek high frame rate video (HFPS): the largest (width, height, fps) the vendor
+     * HAL records at when com.mediatek.streamingfeature.hfpsMode is set, or null if the
+     * camera has no HFPS. On MediaTek HALs frame rates above 30 fps are only reachable
+     * through this mode, even though the AE target FPS range is accepted.
+     */
+    private val mediaTekHfpsMaxResolution: IntArray? = runCatching {
+        val modes = camera2CameraInfo.getCameraCharacteristic(MEDIATEK_HFPS_MODES)
+        camera2CameraInfo.getCameraCharacteristic(MEDIATEK_HFPS_MAX_RESOLUTIONS)
+            ?.takeIf { modes?.contains(1) == true && it.size >= 3 }
+    }.getOrNull()
+
+    /**
+     * Whether this camera has MediaTek HFPS; only then may the vendor tag be set.
+     */
+    val supportsMediaTekHfps = mediaTekHfpsMaxResolution != null
+
+    /**
+     * Whether recording [quality] at [frameRate] needs and is covered by MediaTek HFPS.
+     */
+    fun needsMediaTekHfps(quality: Quality, frameRate: FrameRate?): Boolean {
+        val max = mediaTekHfpsMaxResolution ?: return false
+        val fps = frameRate?.value ?: return false
+        val (width, height) = when (quality) {
+            Quality.SD -> 720 to 480
+            Quality.HD -> 1280 to 720
+            Quality.FHD -> 1920 to 1080
+            Quality.UHD -> 3840 to 2160
+            else -> return false
+        }
+        return fps > 30 && fps <= max[2] && width.toLong() * height <= max[0].toLong() * max[1]
+    }
