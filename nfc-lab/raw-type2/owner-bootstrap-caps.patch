+// Exact read-only Android GET_CAPS request and legacy syntax-error response
+// captured in this ST21's normal bootstrap. NCI constants: PROP=0x0f,
+// ANDROID=0x0c, GET_CAPS=0x00, STATUS_SYNTAX_ERROR=0x05.
+// No other vendor request/status/length is classified by these helpers.
+inline bool isReadOnlyAndroidCapsQuery(const uint8_t* b, size_t n) {
+  return b && n == 4 && b[0] == 0x2f && b[1] == 0x0c && b[2] == 1 &&
+         b[3] == 0;
+}
+inline bool isAndroidLegacySyntaxError(const uint8_t* b, size_t n) {
+  return b && n == 4 && b[0] == 0x4f && b[1] == 0x0c && b[2] == 1 &&
+         b[3] == 0x05;
+}
+}  // namespace lieppos::rawt2
