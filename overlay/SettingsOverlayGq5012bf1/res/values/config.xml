<?xml version="1.0" encoding="utf-8"?>
<!--
    The panel exposes 60, 90 and 120 Hz display modes. Show both the
    Lineage max/min refresh-rate lists and the AOSP Smooth Display switch.
-->
<resources>
    <!-- Lineage: Display > Max refresh rate -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>

    <!-- Lineage: Display > Min refresh rate -->
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- AOSP: Display > Smooth Display -->
    <bool name="config_show_smooth_display">true</bool>

    <!-- Safety & emergency > Wireless emergency alerts. The stock vendor
         MtkSettingsResOverlay (from Ulefone's GMS ROM) points this at
         com.google.android.cellbroadcastreceiver, which is not installed, so
         the entry did nothing. Restore the AOSP module receiver, the package
         CellBroadcastService delivers alerts to. -->
    <string name="config_cell_broadcast_receiver_package" translatable="false">com.android.cellbroadcastreceiver.module</string>
</resources>
