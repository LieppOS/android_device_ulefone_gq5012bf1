//
// Armor lights: Quick Settings tiles for the GQ5012BF1 super flashlight
// (LN2403 camping light: off/lowest/max) and the red and blue LEDs, the
// thermal camera guard and the uSmart accessory notification.
//

android_app {
    name: "ArmorPartsGq5012bf1",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    // Settings > Battery > Charge limit uses Settings' own page components.
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibSettingsTheme",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibMainSwitchPreference",
        "SettingsLibSliderPreference",
        "SettingsLibFooterPreference",
    ],
    certificate: "platform",
    system_ext_specific: true,
    // Shrink only (drops unused androidx/SettingsLib code); no renaming or
    // optimisation. Manifest components are kept by aapt2's generated rules.
    optimize: {
        enabled: true,
        shrink: true,
        optimize: false,
        obfuscate: false,
    },
}
