<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tiles + thermal camera guard (ThermalGuard) + uSmart notifier. Shared uid system: runs as system_app, which the
     stock vendor policy allows to write the yft_camplight (sysfs_yft_file) nodes.
     persistent: a cached tile process gets frozen by the app freezer, which made
     the first tap wait for a thaw and queued fast taps into multi-second bursts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lieppos.armorparts"
    android:sharedUserId="android.uid.system">

    <!-- ThermalGuard: watch ThermoVue's process; pre-grant its all-files access. -->
    <uses-permission android:name="android.permission.SET_ACTIVITY_WATCHER" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <!-- ThermalGuard: stop ThermoVue left in the background with a camera on. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- UsmartNotifier: notification while a uSmart accessory is attached. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- LightApi: keeps strobe timing running with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ArmorApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_biglight"
        android:directBootAware="true"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true">
        <service
            android:name=".FlashlightTile"
            android:label="@string/tile_flashlight"
            android:icon="@drawable/ic_biglight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".RedLightTile"
            android:label="@string/tile_red"
            android:icon="@drawable/ic_led"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".BlueLightTile"
            android:label="@string/tile_blue"
            android:icon="@drawable/ic_led"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Settings > Battery > Charge limit (injected tile, system apps only). -->
        <activity
            android:name=".ChargeLimitActivity"
            android:label="@string/charge_limit_title"
            android:icon="@drawable/ic_charge_limit"
            android:theme="@style/ChargeLimitTheme"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data android:name="com.android.settings.title"
                android:resource="@string/charge_limit_title" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_charge_limit" />
            <meta-data android:name="com.android.settings.summary_uri"
                android:value="content://org.lieppos.armorparts.chargelimit/getDynamicSummary/charge_limit" />
        </activity>
        <provider
            android:name=".ChargeLimitProvider"
            android:authorities="org.lieppos.armorparts.chargelimit"
            android:exported="true" />
    </application>
</manifest>
