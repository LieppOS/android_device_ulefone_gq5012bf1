service gq5012bf1-security-prep /system/bin/sh /system/bin/gq5012bf1-security-setup.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service teed /vendor/bin/teed \
    --tzdev /dev/tkcore_admin \
    --datapath /data/vendor/t6/fs \
    --sptapath /data/vendor/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/vendor/persist/t6 \
    --prot /mnt/vendor/protect_f/tee \
    --prebuilt /vendor/app/t6/data \
    --logpath /data/vendor/t6/tkcore.log \
    --proprefix vendor.trustkernel
    class core
    user system
    group system
    capabilities SYS_RAWIO
    disabled

service vendor.keymint-3-0-trustkernel /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel
    class early_hal
    user system
    group system
    disabled

service vendor.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trustkernel
    class hal
    user system
    group system
    disabled

service gq5012bf1-keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:keystore:s0
    disabled

# ISOLATION BUILD - discriminating test, not a candidate fix.
#
# No TrustKernel service starts automatically. teed, Gatekeeper, KeyMint and
# Keystore2 are driven manually over ADB exactly once, from a truly clean cold
# boot, after recovery has mounted metadata-encrypted /data. This separates:
#   H1 - TEE secure storage (/data/vendor/t6/fs) unavailable because we declare
#        vendor.trustkernel.fs.state=ready before /data exists, and
#   H2 - KeyMint latching ro.build.version.release once per TA lifetime.
# See CLAUDE_FBE_REPORT.md. The previous Gatekeeper-14/KeyMint-16 split is
# removed here: the Gatekeeper HAL binary reads no build property at all.
on boot
    stop keystore2
    stop vendor.boot-default
    start gq5012bf1-security-prep
    # BootControl must stay unconditional; recovery otherwise blocks on
    # IBootControl at the splash logo (commit 078db47).
    start vendor.boot-default

# Prepare the Keystore2 temp DB directory only. This starts no service, so it
# does not contaminate the test, and keeps the already-proven DB labelling out
# of the manual sequence.
on property:vendor.trustkernel.fs.state=ready
    mkdir /tmp/misc 0755 root root
    mkdir /tmp/misc/keystore 0755 root root
    restorecon_recursive /tmp/misc/keystore
    restorecon /system/bin/keystore2
