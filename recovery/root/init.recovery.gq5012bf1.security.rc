service gq5012bf1-security-prep /system/bin/sh /system/bin/gq5012bf1-security-setup.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service teed /vendor/bin/teed \
    --tzdev /dev/tkcore_admin \
    --datapath /data/vendor/t6/fs \
    --sptapath /data/vendor/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/vendor/persist/t6 \
    --prot /mnt/vendor/protect_f/tee \
    --prebuilt /vendor/app/t6/data \
    --logpath /data/vendor/t6/tkcore.log \
    --proprefix vendor.trustkernel
    class core
    user system
    group system
    capabilities SYS_RAWIO
    disabled

service vendor.keymint-3-0-trustkernel /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel
    class early_hal
    user system
    group system
    disabled

service vendor.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trustkernel
    class hal
    user system
    group system
    disabled

service gq5012bf1-tee-storage /system/bin/sh /system/bin/gq5012bf1-tee-storage.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service gq5012bf1-keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:keystore:s0
    disabled

# Stock two-stage TrustKernel handshake.
#
# Stage 1 (gq5012bf1-security-prep) mounts the active system/vendor, installs
# the VINTF and identity inputs, and announces fs.state=prepare.
# Stage 2 (gq5012bf1-tee-storage) waits for OrangeFox to mount the
# metadata-encrypted /data, creates the teed datapath there, and only then
# announces fs.state=ready. teed must not start before that: tee_userinit runs
# once per secure-world lifetime and cannot be redone by restarting the HALs.
on boot
    stop keystore2
    stop vendor.boot-default
    start gq5012bf1-security-prep
    # BootControl must stay unconditional; recovery otherwise blocks on
    # IBootControl at the splash logo (commit 078db47).
    start vendor.boot-default

# teed starts here, mirroring stock's "on post-fs / start teed". It must NOT
# wait for /data: recovery gets the metadata key from KeyMint, KeyMint needs
# teed, and /data cannot be mounted until that key is retrieved. Gating teed
# on /data therefore deadlocks recovery at the splash.
on property:vendor.trustkernel.fs.state=prepare
    start teed
    start gq5012bf1-tee-storage

# KeyMint starts as soon as teed is up. Recovery needs it to retrieve the
# metadata key, and it must not be gated behind anything that depends on /data.
on property:vendor.trustkernel.ready=true
    start vendor.keymint-3-0-trustkernel

# Gatekeeper is started AFTER KeyMint is already running, never at the same
# time. Build25 and Build26 started both from vendor.trustkernel.ready=true
# simultaneously and reproduced the Keystore2 failure "No suitable auth token
# found" / KEY_USER_NOT_AUTHENTICATED. Serialising the two trusted-application
# sessions is what fixes it.
#
# Nothing here depends on /data. Recovery blocks at the splash until Gatekeeper
# and Keystore2 exist, so anything gated behind /data deadlocks the boot.
on property:init.svc.vendor.keymint-3-0-trustkernel=running
    exec u:r:recovery:s0 root root -- /system/bin/sleep 5
    start vendor.gatekeeper

on property:init.svc.vendor.gatekeeper=running
    exec u:r:recovery:s0 root root -- /system/bin/sleep 1
    mkdir /tmp/misc 0755 root root
    mkdir /tmp/misc/keystore 0755 root root
    restorecon_recursive /tmp/misc/keystore
    restorecon /system/bin/keystore2
    start gq5012bf1-keystore2
